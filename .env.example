# Copy to .env.local and fill in real values. .env.local is gitignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used only in /app/api/* route handlers.
# NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL ---
# Canonical origin of THIS deployment, no trailing slash
# (e.g. https://hostiggo.com). Used to build the Google OAuth redirect
# (`${NEXT_PUBLIC_SITE_URL}/auth/callback`). This exact URL must also be
# added under Supabase → Authentication → URL Configuration → Redirect URLs,
# and the same origin set as the Site URL there. Leave blank locally to fall
# back to window.location.origin (http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# --- Google Maps ---
# Needs the Maps JavaScript API, Places API, and Geocoding API enabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Backend microservices (optional, per-feature) ---
PROPERTY_UPLOAD_URL=
AI_CHAT_MONITOR_URL=
ICAL_URL=

# --- Twilio WhatsApp notifications ---
# Server-only. Use the WhatsApp-enabled sender number and approved Content
# Template SIDs from Twilio Content API. Never prefix these with NEXT_PUBLIC_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_BOOKING_CONFIRMATION_GUEST_EN=
TWILIO_TEMPLATE_BOOKING_RECEIVED_HOST_EN=
# Delivery status (incl. Meta rejections like 63112) is posted back to
# ${NEXT_PUBLIC_SITE_URL}/api/webhooks/twilio-status -- only when that is https.

# Guards /api/cron/* and the manual /api/test/whatsapp sender
# (Authorization: Bearer <value>). Server-only.
CRON_SECRET=

# --- SurePass (identity verification: PAN, passport, bank) ---
# Server-only -- called from /app/api/verify/*
# route handlers only. NEVER prefix with NEXT_PUBLIC_. Production only (no
# sandbox environment) -- leave SUREPASS_BASE_URL unset to default to
# https://kyc-api.surepass.app.
SUREPASS_API_KEY=
SUREPASS_BASE_URL=

# Set to "true" to grey out the Book button site-wide (bookings are on by default).
NEXT_PUBLIC_BOOKINGS_DISABLED=

# --- Payments & bookings (Razorpay) ---
# Server-only keys. RAZORPAY_ACCOUNT_NUMBER is the RazorpayX account used for
# Route payouts to hosts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=
# Must be "true" in production. When it isn't, bookings are CLOSED (the site
# never creates unpaid bookings unless explicitly allowed below).
NEXT_PUBLIC_PAYMENTS_ENABLED=
# Staging/testing ONLY: with payments off, create confirmed bookings without
# charging. Never set this in production.
NEXT_PUBLIC_ALLOW_UNPAID_BOOKINGS=

# --- Search ---
# Optional. When set, /api/search and /api/locations are proxied to this
# external search service. Leave unset to serve search from this app
# (Supabase RPC) -- the default and the safe choice.
SEARCH_SERVICE_URL=

# --- Other services ---
AI_LISTER_URL=
NEXT_PUBLIC_ICAL_SERVICE_URL=
# Expo push notifications (mobile app).
EXPO_ACCESS_TOKEN=
# Guards /api/admin/* (Authorization: Bearer <value>). Server-only.
ADMIN_SECRET=

# --- Marketing & launch (all optional; each only activates when set) ---
# Analytics load only after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Digits with country code, e.g. 919876543210. Defaults to the support phone.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Full https:// profile URLs. Unset ones are simply not shown or put in structured data.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Email, alerts, rate limiting, guest ID ---
RESEND_API_KEY=
EMAIL_FROM=
SLACK_WEBHOOK_URL=
ADMIN_ALERT_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REQUIRE_GUEST_ID_VERIFICATION=
